@model LogoModel
<a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" aria-label="@Model.StoreName homepage">
    <img alt="@Model.StoreName"
         src="@Model.LogoPath"
         @(!string.IsNullOrEmpty(Model.SrcSet) ? Html.Raw($"srcset=\"{Model.SrcSet}\"") : null)
         width="@(Model.Width ?? 1000)"
         height="@(Model.Height ?? 200)"
         decoding="async"
         loading="eager"
         fetchpriority="high">
</a>