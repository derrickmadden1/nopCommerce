<script asp-location="Footer">
    $(function() {
        try {
            if (sessionStorage.getItem('eu_cookie_dismissed') === 'true') {
                return;
            }
        } catch (e) {}

        $('#eu-cookie-bar-notification').fadeIn(250);

        $('#eu-cookie-close').on('click', function () {
            $('#eu-cookie-bar-notification').fadeOut(250);
            try {
                sessionStorage.setItem('eu_cookie_dismissed', 'true');
            } catch (e) {}
            document.dispatchEvent(new CustomEvent('eu-cookie-dismissed', { detail: { accepted: false } }));
        });

        $('#eu-cookie-ok').on('click', function () {
            $('#eu-cookie-bar-notification').fadeOut(250);
            try {
                sessionStorage.setItem('eu_cookie_dismissed', 'true');
            } catch (e) {}
            document.dispatchEvent(new CustomEvent('eu-cookie-dismissed', { detail: { accepted: true } }));

            if (typeof window.clarity === 'function') {
                window.clarity('consentv2', {
                    analytics_Storage: 'granted',
                    ad_Storage: 'granted'
                });
            }

            var postData = {};
            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: "POST",
                data: postData,
                url: "@Url.RouteUrl(NopRouteNames.Ajax.EU_COOKIE_LAW_ACCEPT)",
                dataType: "json",
                error: function (jqXHR, textStatus, errorThrown) {
                    console.warn('Could not persist cookie acceptance:', textStatus);
                }
            });
        });
    });
</script>
<div id="eu-cookie-bar-notification" class="eu-cookie-bar-notification" role="dialog" aria-label="Cookie consent">
    <button type="button" class="close-button" id="eu-cookie-close" aria-label="Dismiss cookie notice">&times;</button>
    <div class="content">
        <div class="text">@T("EUCookieLaw.Description2")</div>
        <div class="buttons-more">
            <button type="button" class="ok-button button-1" id="eu-cookie-ok">@T("Common.OK")</button>
            <a class="learn-more" href="@await NopUrl.RouteTopicUrlAsync("privacyinfo")">@T("EUCookieLaw.LearnMore")</a>
        </div>
    </div>
</div>
