@model CheckoutPaymentInfoModel
@{
    Layout = "_ColumnsOne";

    //title
    NopHtml.AddTitleParts(T("PageTitle.Checkout").Text);
    //page class
    NopHtml.AppendPageCssClassParts("html-checkout-page");
    NopHtml.AppendPageCssClassParts("html-payment-info-page");
    var isSquarePayment = Model.PaymentViewComponent?.Name?.Contains("Square", StringComparison.OrdinalIgnoreCase) == true;
}

<div class="page checkout-page payment-info-page section-container">
    @await Component.InvokeAsync("CheckoutProgress", new { step = CheckoutProgressStep.Payment })
    
    <div class="section-header">
        <h1>@T("Checkout.PaymentInfo")</h1>
    </div>

    <div class="page-body checkout-data">
        <div class="payment-info-modern">
            <form asp-route="@NopRouteNames.Standard.CHECKOUT_PAYMENT_INFO" method="post">
                @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.CheckoutPaymentInfoTop, additionalData = Model })

                <div asp-validation-summary="ModelOnly" class="message-error"></div>

                @if (Context.Request.Query.ContainsKey("retry") || (Context.Request.Headers.Referer.ToString().Contains("checkout/confirm", StringComparison.OrdinalIgnoreCase) && !ViewData.ModelState.IsValid))
                {
                    <div class="payment-retry-alert" style="margin-bottom: 25px; padding: 16px 20px; border-radius: 8px; border-left: 5px solid #3182ce; background-color: #ebf8ff; color: #2b6cb0; font-size: 0.95rem; display: flex; align-items: center; gap: 12px; box-shadow: 0 2px 8px rgba(49, 130, 206, 0.08);">
                        <i class="fas fa-info-circle" style="font-size: 1.25rem; flex-shrink: 0;"></i>
                        <span>Please re-enter or update your card details below to proceed with your order.</span>
                    </div>
                }

                <div class="payment-info-content-modern">
                    @await Component.InvokeAsync(Model.PaymentViewComponent)
                </div>

                <div class="checkout-footer-modern payment-info-default-footer @(isSquarePayment ? "payment-info-default-footer-hidden d-none" : "")" style="@(isSquarePayment ? "display: none !important; position: absolute !important; left: -9999px !important;" : "")">
                    <button type="submit" name="nextstep" class="btn-primary next-step-btn payment-info-next-step-button @(isSquarePayment ? "hidden-button" : "")" style="@(isSquarePayment ? "display: none !important;" : "")">
                        @T("Checkout.NextButton") <i class="fas fa-arrow-right"></i>
                    </button>
                </div>

                @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.CheckoutPaymentInfoBottom, additionalData = Model })
            </form>
        </div>

        <div class="section order-summary">
            <div class="section-title">
                <h2>@T("Checkout.OrderSummary")</h2>
            </div>
            @await Component.InvokeAsync("OrderSummary")
        </div>
    </div>
</div>
