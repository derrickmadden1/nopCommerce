@model ProductReviewOverviewModel
@{
    var ratingPercent = 0;
    var noReviews = Model.TotalReviews == 0;
    if (!noReviews)
    {
        ratingPercent = ((Model.RatingSum * 100) / Model.TotalReviews) / 5;
    }
}
@if (Model.AllowCustomerReviews)
{
    <div class="product-reviews-overview product-reviews-overview-modern">
        <div class="product-review-box">
            <div class="rating-modern" title="@ratingPercent%">
                @for (int i = 1; i <= 5; i++)
                {
                    if (ratingPercent >= (i * 20))
                    {
                        <i class="fas fa-star filled"></i>
                    }
                    else if (ratingPercent >= ((i - 1) * 20 + 10))
                    {
                        <i class="fas fa-star-half-alt filled"></i>
                    }
                    else
                    {
                        <i class="far fa-star empty"></i>
                    }
                }
            </div>
        </div>

        @if (Model.TotalReviews > 0)
        {
            <div class="product-review-links">
                <a href="#productreviews" class="review-scroll-link">@Model.TotalReviews @T("Reviews.Overview.Reviews")</a>
            </div>
        }

        @if (Model.CanAddNewReview && Model.CanCurrentCustomerLeaveReview)
        {
            <div class="product-review-links add-review @(noReviews ? "product-no-reviews" : "")">
                <a href="#addreview" class="review-scroll-link">@T(noReviews ? "Reviews.Overview.First" : "Reviews.Overview.AddNew")</a>
            </div>
        }
        
        <script asp-location="Footer">
            document.addEventListener("DOMContentLoaded", function() {
                function scrollToReviews(targetId) {
                    const targetElement = document.getElementById(targetId) || 
                                          document.querySelector(`[name="${targetId}"]`) || 
                                          document.getElementById('addreview') || 
                                          document.getElementById('productreviews') || 
                                          document.getElementById('product-reviews-section') || 
                                          document.querySelector('.product-reviews');
                    if (targetElement) {
                        const header = document.querySelector('.header-modern') || document.querySelector('header');
                        const headerOffset = header ? header.offsetHeight + 20 : 80;
                        const elementPosition = targetElement.getBoundingClientRect().top;
                        const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

                        window.scrollTo({
                            top: Math.max(0, offsetPosition),
                            behavior: 'smooth'
                        });

                        const firstInput = targetElement.querySelector('input[type="text"]:not([type="hidden"]), textarea') || 
                                           document.querySelector('#AddProductReview_Title');
                        if (firstInput) {
                            setTimeout(function() {
                                firstInput.focus({ preventScroll: true });
                            }, 500);
                        }
                    }
                }

                const reviewLinks = document.querySelectorAll('.review-scroll-link');
                reviewLinks.forEach(function(link) {
                    link.addEventListener('click', function(e) {
                        e.preventDefault();
                        const href = this.getAttribute('href');
                        const targetId = (href && href.startsWith('#')) ? href.substring(1) : 'addreview';
                        scrollToReviews(targetId);
                    });
                });

                if (window.location.hash === '#addreview' || window.location.hash === '#productreviews') {
                    setTimeout(function() {
                        scrollToReviews(window.location.hash.substring(1));
                    }, 300);
                }
            });
        </script>
    </div>
}
