@inherits Nop.Web.Framework.Mvc.Razor.NopRazorPage<TModel>
@using Nop.Web.Components
@using Nop.Web.Framework.Infrastructure
@using Nop.Web.Framework.UI
@using Nop.Web.Models.Common
@inject Nop.Web.Factories.ICommonModelFactory commonModelFactory
@inject Nop.Web.Factories.ICatalogModelFactory catalogModelFactory
@{
    var socialModel = await commonModelFactory.PrepareSocialModelAsync();
    var headerLinksModel = await commonModelFactory.PrepareHeaderLinksModelAsync();
    var categoryNavModel = await catalogModelFactory.PrepareCategoryNavigationModelAsync(0, 0);
    var rootCategories = categoryNavModel?.Categories ?? new List<CategorySimpleModel>();

    var currentController = Url.ActionContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = Url.ActionContext.RouteData.Values["action"]?.ToString() ?? "";

    var isHomePage = currentController.Equals("home", StringComparison.InvariantCultureIgnoreCase) &&
                     currentAction.Equals("index", StringComparison.InvariantCultureIgnoreCase);
    var isSearchPage = currentController.Equals("catalog", StringComparison.InvariantCultureIgnoreCase) &&
                       currentAction.Equals("search", StringComparison.InvariantCultureIgnoreCase);
    var isCartPage = currentController.Equals("shoppingcart", StringComparison.InvariantCultureIgnoreCase) &&
                     currentAction.Equals("cart", StringComparison.InvariantCultureIgnoreCase);
    var isAccountPage = currentController.Equals("customer", StringComparison.InvariantCultureIgnoreCase);
    var isCategoryPage = currentController.Equals("catalog", StringComparison.InvariantCultureIgnoreCase) &&
                         currentAction.Equals("category", StringComparison.InvariantCultureIgnoreCase);

    var currentCategoryId = 0;
    if (isCategoryPage && Url.ActionContext.RouteData.Values["categoryId"] != null)
    {
        int.TryParse(Url.ActionContext.RouteData.Values["categoryId"].ToString(), out currentCategoryId);
    }
    var currentSeName = ViewContext.RouteData.Values["SeName"]?.ToString() ?? "";
}

<style>
    /* 1. Header Layout Fixes */
    .header-modern .header-main-area {
        max-width: var(--max-width, 1300px);
        margin: 0 auto;
        padding: 20px 40px;
        position: relative;
    }

    .header-logo-row {
        display: flex !important;
        flex-direction: row !important;
        justify-content: center !important;
        align-items: center !important;
        width: 100% !important;
        min-height: 120px !important;
        position: relative !important;
    }

    .header-logo {
        text-align: center !important;
        flex: 0 0 auto !important;
    }

    .header-logo img {
        max-height: 180px !important;
        max-width: 90% !important;
        width: auto !important;
        height: auto !important;
        transition: all 0.4s ease !important;
        filter: none !important;
    }

    @@media (max-width: 1250px) {
        .header-logo img {
            max-height: 120px !important;
        }
    }

    @@media (max-width: 1024px) {
        .header-logo img {
            max-height: 80px !important;
        }
    }

    @@media (max-width: 768px) {
        .header-logo img {
            max-height: 55px !important;
        }
    }

    @@media (max-width: 480px) {
        .header-logo img {
            max-height: 50px !important;
        }
    }

    .header-search-cart {
        position: absolute !important;
        right: 0 !important;
        top: 50% !important;
        transform: translateY(-50%) !important;
        display: flex !important;
        align-items: center !important;
        gap: 20px !important;
        z-index: 10 !important;
    }

    /* 2. Panels - ABSOLUTELY HIDDEN BY DEFAULT */
    /* We use highly specific selectors to ensure they are hidden */
    body #mini-cart-panel, 
    body #mobile-nav-panel, 
    body #mini-cart-overlay, 
    body #mobile-nav-overlay {
        display: none !important;
        visibility: visible !important; 
    }

    body #mini-cart-panel {
        position: fixed !important;
        top: 0 !important;
        right: 0 !important;
        width: 400px !important;
        height: 100vh !important;
        background: #fff !important;
        z-index: 100000 !important;
        box-shadow: 0 0 50px rgba(0,0,0,0.3) !important;
        padding: 40px !important;
        flex-direction: column !important;
    }

    body #mobile-nav-panel {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 320px !important;
        height: 100vh !important;
        background: #fff !important;
        z-index: 100000 !important;
        box-shadow: 0 0 50px rgba(0,0,0,0.3) !important;
        padding: 0 !important; /* Premium: zero padding allows edge-to-edge content */
        flex-direction: column !important;
    }

    body #mini-cart-overlay, 
    body #mobile-nav-overlay {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        background: rgba(0,0,0,0.6) !important;
        z-index: 99999 !important;
    }

    /* Open States */
    body #mini-cart-panel.open, 
    body #mobile-nav-panel.open {
        display: flex !important;
    }

    body #mini-cart-overlay.visible, 
    body #mobile-nav-overlay.visible {
        display: block !important;
    }

    /* Search Box Refinement */
    .search-box {
        display: flex !important;
        align-items: center !important;
    }
    .search-box form {
        display: flex !important;
    }
    .search-box-text {
        width: 200px !important;
        padding: 8px !important;
        border: 1px solid #ddd !important;
    }
    .search-box-button {
        padding: 8px 15px !important;
        background: #1b1b1b !important;
        color: #fff !important;
        border: none !important;
    }

    .header-mobile-spacer {
        display: none !important;
    }

    @@media (max-width: 991px) {
        .header-search-cart {
            position: static !important;
            transform: none !important;
            justify-content: center !important;
            width: 100% !important;
            margin-top: 20px !important;
        }
        .header-logo-row {
            flex-direction: column !important;
        }
        #mini-cart-panel { width: 100% !important; }
    }

    @@media (max-width: 768px) {
        .header-modern .header-main-area {
            padding: 12px 15px !important;
        }
        .header-logo-row {
            display: flex !important;
            flex-direction: row !important;
            flex-wrap: wrap !important;
            align-items: center !important;
            justify-content: space-between !important;
            min-height: unset !important;
            padding: 0 !important;
            position: relative !important;
        }
        .mobile-menu-toggle {
            display: inline-flex !important;
            align-items: center !important;
            gap: 6px !important;
            padding: 6px 11px !important;
            position: static !important;
            transform: none !important;
            margin: 0 !important;
            flex: 0 0 auto !important;
            box-sizing: border-box !important;
        }
        .header-logo {
            flex: 1 1 auto !important;
            text-align: center !important;
            padding: 0 8px !important;
            min-width: 0 !important;
        }
        .header-logo img {
            max-height: 42px !important;
            max-width: 100% !important;
            height: auto !important;
            width: auto !important;
            display: inline-block !important;
        }
        .header-mobile-spacer {
            display: block !important;
            flex: 0 0 68px !important;
            width: 68px !important;
            height: 1px !important;
        }
        .header-search-cart {
            width: 100% !important;
            margin-top: 14px !important;
        }
    }
</style>

@await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderBefore })
<header class="header-modern">

    <!-- Top Announcement Bar (Turquoise) -->
    <div class="announcement-bar">
        <span>*** Free UK Shipping On All Orders Over £40 ***</span>
    </div>

    <!-- Utility Bar (Dark) -->
    <div class="header-utility">
        <div class="utility-container">
            <div class="utility-social">
                @if (!string.IsNullOrEmpty(socialModel.FacebookLink))
                {
                    <a href="@socialModel.FacebookLink" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                }
                @if (!string.IsNullOrEmpty(socialModel.InstagramLink))
                {
                    <a href="@socialModel.InstagramLink" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                }
                @if (!string.IsNullOrEmpty(socialModel.XLink))
                {
                    <a href="@socialModel.XLink" target="_blank" rel="noopener noreferrer" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                }
            </div>
            <div class="utility-actions">
                @await Component.InvokeAsync("CurrencySelector")
                @await Component.InvokeAsync("LanguageSelector")
                @await Component.InvokeAsync("HeaderLinks")
            </div>
        </div>
    </div>

    <!-- Main Header Area -->
    <div class="header-main-area">
        <!-- Logo Row -->
        <div class="header-logo-row">
            <!-- Hamburger Menu Button with Text Label (Mobile Only) -->
            <button id="mobile-menu-toggle" class="mobile-menu-toggle" aria-label="Toggle navigation" type="button">
                <span class="hamburger-icon" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                </span>
                <span class="mobile-menu-label">Menu</span>
            </button>

            <div class="header-logo">
                @await Component.InvokeAsync(typeof(LogoViewComponent))
            </div>

            <!-- Mobile Balance Spacer to keep logo centered without overlapping -->
            <div class="header-mobile-spacer" aria-hidden="true"></div>
            
            <div class="header-search-cart">
                <div class="search-box">
                    @await Component.InvokeAsync(typeof(SearchBoxViewComponent))
                </div>
            </div>
        </div>

        <!-- Navigation Row -->
        <nav class="main-nav-row">
            @inject Nop.Services.Plugins.IPluginService pluginService

            @{
                var descriptor = pluginService
                .GetPluginDescriptorBySystemNameAsync<Nop.Services.Plugins.IPlugin>("Misc.MegaMenu")
                .Result;

                var megaMenuInstalled = descriptor != null;
            }

            @if (megaMenuInstalled)
            {
                @await Component.InvokeAsync("MegaMenu")
            }
        </nav>
    </div>

    @if (rootCategories.Any())
    {
        <!-- Mobile Category Chip Strip -->
        <div class="mobile-category-strip-wrapper">
            <nav class="mobile-category-strip" aria-label="Categories">
                <button type="button" class="category-chip category-chip-all" onclick="openMobileNav()" aria-label="Open full menu">
                    <i class="fas fa-bars" aria-hidden="true"></i>
                    <span>All</span>
                </button>
                @foreach (var category in rootCategories)
                {
                    var hasValidUrl = !string.IsNullOrEmpty(category.SeName);
                    var isCurrent = (category.Id == currentCategoryId) || (hasValidUrl && !string.IsNullOrEmpty(currentSeName) && category.SeName.Equals(currentSeName, StringComparison.InvariantCultureIgnoreCase));

                    if (hasValidUrl)
                    {
                        <a href="@Url.RouteUrl("Category", new { SeName = category.SeName })" class="category-chip @(isCurrent ? "active" : "")">
                            @category.Name
                        </a>
                    }
                    else
                    {
                        <button type="button" class="category-chip" onclick="openMobileNavToCategory('@category.Name')" aria-label="Browse @category.Name categories">
                            <span>@category.Name</span>
                            <i class="fas fa-chevron-down chip-dropdown-icon" aria-hidden="true"></i>
                        </button>
                    }
                }
            </nav>
        </div>
    }

</header>
@await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderAfter })

<!-- Panels moved OUTSIDE the header for isolation -->
<div id="mini-cart-overlay" class="mini-cart-overlay" style="display: none !important;"></div>
<div id="mini-cart-panel" class="mini-cart-panel" style="display: none !important;">
    <div class="mini-cart-header" style="display:flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h3 style="margin:0;">Your Cart</h3>
        <a href="javascript:void(0)" id="cart-close" onclick="closeCartPanel()" style="color: #1b1b1b; text-decoration: none; font-size: 2rem; font-weight: bold;">&times;</a>
    </div>
    <div id="flyout-cart">
        @await Component.InvokeAsync("FlyoutShoppingCart")
    </div>
</div>

<div id="mobile-nav-panel" class="mobile-nav-panel" style="display: none !important;">
    <div class="mobile-nav-header">
        <h3>Menu</h3>
        <a href="javascript:void(0)" id="mobile-nav-close" onclick="closeMobileNav()"><i class="fas fa-times"></i></a>
    </div>
    <nav class="mobile-nav-content">
        @if (megaMenuInstalled)
        {
            @await Component.InvokeAsync("MegaMenu")
        }
    </nav>
    <div class="mobile-nav-utility">
        @await Component.InvokeAsync("HeaderLinks")
        <div class="mobile-utility-selectors">
            @await Component.InvokeAsync("CurrencySelector")
            @await Component.InvokeAsync("LanguageSelector")
        </div>
    </div>
</div>
<div id="mobile-nav-overlay" class="mobile-nav-overlay" style="display: none !important;"></div>

<!-- Mobile Bottom Navigation Bar (Thumb Zone) -->
<nav class="mobile-bottom-nav" aria-label="Mobile Navigation">
    <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" class="mobile-bottom-nav-item @(isHomePage ? "active" : "")" aria-label="Home">
        <i class="fas fa-home" aria-hidden="true"></i>
        <span>Home</span>
    </a>
    <button type="button" class="mobile-bottom-nav-item @(isCategoryPage ? "active" : "")" onclick="openMobileNav()" aria-label="Open categories menu">
        <i class="fas fa-th-large" aria-hidden="true"></i>
        <span>Categories</span>
    </button>
    <button type="button" class="mobile-bottom-nav-item @(isSearchPage ? "active" : "")" onclick="focusMobileSearch()" aria-label="Search store">
        <i class="fas fa-search" aria-hidden="true"></i>
        <span>Search</span>
    </button>
    @if (headerLinksModel.ShoppingCartEnabled)
    {
        <button type="button" class="mobile-bottom-nav-item @(isCartPage ? "active" : "")" onclick="openCartPanel()" aria-label="View cart">
            <span class="bottom-nav-icon-wrapper">
                <i class="fas fa-shopping-bag" aria-hidden="true"></i>
                <span id="bottom-cart-badge" class="bottom-cart-badge" style="@(headerLinksModel.ShoppingCartItems > 0 ? "" : "display:none;")">@headerLinksModel.ShoppingCartItems</span>
            </span>
            <span>Cart</span>
        </button>
    }
    <a href="@(headerLinksModel.IsAuthenticated ? Url.RouteUrl(NopRouteNames.General.CUSTOMER_INFO) : Url.RouteUrl(NopRouteNames.General.LOGIN))" class="mobile-bottom-nav-item @(isAccountPage ? "active" : "")" aria-label="My account">
        <i class="fas fa-user" aria-hidden="true"></i>
        <span>Account</span>
    </a>
</nav>

<script>
    // Logic for toggling panels
    function openCartPanel() {
        const panel = document.getElementById("mini-cart-panel");
        const overlay = document.getElementById("mini-cart-overlay");
        if (panel) {
            panel.style.setProperty("display", "flex", "important");
            panel.classList.add("open");
        }
        if (overlay) {
            overlay.style.setProperty("display", "block", "important");
            overlay.classList.add("visible");
        }
    }

    function closeCartPanel() {
        const panel = document.getElementById("mini-cart-panel");
        const overlay = document.getElementById("mini-cart-overlay");
        if (panel) {
            panel.style.setProperty("display", "none", "important");
            panel.classList.remove("open");
        }
        if (overlay) {
            overlay.style.setProperty("display", "none", "important");
            overlay.classList.remove("visible");
        }
    }

    function openMobileNav() {
        const panel = document.getElementById("mobile-nav-panel");
        const overlay = document.getElementById("mobile-nav-overlay");
        if (panel) {
            panel.style.setProperty("display", "flex", "important");
            panel.classList.add("open");
        }
        if (overlay) {
            overlay.style.setProperty("display", "block", "important");
            overlay.classList.add("visible");
        }
        document.body.style.overflow = "hidden";
    }

    function closeMobileNav() {
        const panel = document.getElementById("mobile-nav-panel");
        const overlay = document.getElementById("mobile-nav-overlay");
        if (panel) {
            panel.style.setProperty("display", "none", "important");
            panel.classList.remove("open");
        }
        if (overlay) {
            overlay.style.setProperty("display", "none", "important");
            overlay.classList.remove("visible");
        }
        document.body.style.overflow = "";
    }

    function openMobileNavToCategory(categoryName) {
        openMobileNav();
        if (categoryName) {
            const mobileNavPanel = document.getElementById("mobile-nav-panel");
            if (mobileNavPanel) {
                const items = mobileNavPanel.querySelectorAll(".mega-menu-item");
                items.forEach(item => {
                    const link = item.querySelector("a");
                    if (link && link.textContent.trim().toLowerCase() === categoryName.trim().toLowerCase()) {
                        item.classList.add("expanded");
                        const toggleBtn = item.querySelector(".mobile-menu-toggle-btn");
                        if (toggleBtn) toggleBtn.setAttribute("aria-expanded", "true");
                        setTimeout(() => {
                            item.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                        }, 150);
                    }
                });
            }
        }
    }

    // Mobile Search Bar Focus helper
    function focusMobileSearch() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        const searchInput = document.getElementById("small-searchterms");
        if (searchInput) {
            setTimeout(function() {
                searchInput.focus();
                searchInput.classList.add("search-highlight");
                setTimeout(function() {
                    searchInput.classList.remove("search-highlight");
                }, 1800);
            }, 250);
        }
    }

    // Dynamic Bottom Cart Badge synchronization
    function updateBottomCartBadge() {
        const qtyElem = document.querySelector('.cart-qty');
        const badge = document.getElementById('bottom-cart-badge');
        if (badge) {
            if (qtyElem) {
                const text = qtyElem.textContent.replace(/[^\d]/g, '').trim();
                const count = parseInt(text, 10) || 0;
                badge.textContent = count;
                badge.style.display = count > 0 ? 'inline-flex' : 'none';
            }
        }
    }

    // Ajax Cart Override
    if (typeof AjaxCart !== 'undefined') {
        var originalSuccess = AjaxCart.success_process;
        AjaxCart.success_process = function(response) {
            var result = originalSuccess.apply(this, arguments);
            if (response.updateflyoutcartsectionhtml || (response.success && response.message)) {
                 openCartPanel();
            }
            setTimeout(updateBottomCartBadge, 250);
            return result;
        };
    }

    // Diagnostics & Event Bindings
    document.addEventListener("DOMContentLoaded", function() {
        // Diagnostic Log
        const panel = document.getElementById("mini-cart-panel");
        if (panel) {
            console.log("DIAGNOSTIC - Mini Cart Display:", window.getComputedStyle(panel).display);
            console.log("DIAGNOSTIC - Mini Cart Inline:", panel.getAttribute("style"));
        }

        const cartTrigger = document.getElementById("topcartlink");
        if (cartTrigger) {
            let cartTimeout;
            cartTrigger.addEventListener("mouseenter", openCartPanel);
            cartTrigger.addEventListener("mouseleave", () => {
                cartTimeout = setTimeout(closeCartPanel, 800);
            });
            const panel = document.getElementById("mini-cart-panel");
            if (panel) {
                panel.addEventListener("mouseenter", () => clearTimeout(cartTimeout));
                panel.addEventListener("mouseleave", () => closeCartPanel());
            }
        }

        const menuTrigger = document.getElementById("mobile-menu-toggle");
        if (menuTrigger) {
            menuTrigger.addEventListener("click", openMobileNav);
        }

        const cartOverlay = document.getElementById("mini-cart-overlay");
        if (cartOverlay) cartOverlay.addEventListener("click", closeCartPanel);

        const navOverlay = document.getElementById("mobile-nav-overlay");
        if (navOverlay) navOverlay.addEventListener("click", closeMobileNav);

        updateBottomCartBadge();
        if (window.jQuery) {
            $(document).ajaxComplete(function() {
                setTimeout(updateBottomCartBadge, 250);
            });
        }

        // Mobile Navigation Sub-menu Toggling
        const mobileNavPanel = document.getElementById("mobile-nav-panel");
        if (mobileNavPanel) {
            const menuItems = mobileNavPanel.querySelectorAll(".mega-menu-item");
            menuItems.forEach(item => {
                const subPanel = item.querySelector(".mega-menu-panel");
                if (subPanel) {
                    item.classList.add("has-sublist");

                    // Create toggle button
                    const toggleBtn = document.createElement("button");
                    toggleBtn.type = "button";
                    toggleBtn.className = "mobile-menu-toggle-btn";
                    toggleBtn.innerHTML = '<i class="fas fa-chevron-down"></i>';
                    toggleBtn.setAttribute("aria-label", "Toggle sub-menu");
                    toggleBtn.setAttribute("aria-expanded", "false");
                    
                    const parentLink = Array.from(item.children).find(el => el.tagName && el.tagName.toLowerCase() === 'a');

                    function toggleSubMenu(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        const isExpanded = item.classList.toggle("expanded");
                        toggleBtn.setAttribute("aria-expanded", isExpanded.toString());
                    }

                    // For parent categories with no direct page, clicking either the row or chevron toggles the subcategories
                    toggleBtn.addEventListener("click", toggleSubMenu);
                    if (parentLink) {
                        parentLink.addEventListener("click", toggleSubMenu);
                    }
                    
                    item.appendChild(toggleBtn);
                }
            });
        }

        // Desktop Mega Menu boundary check to prevent displaying off screen
        const megaMenuItems = document.querySelectorAll(".mega-menu-root > .mega-menu-item");
        megaMenuItems.forEach(item => {
            const panel = item.querySelector(".mega-menu-panel");
            if (panel) {
                item.addEventListener("mouseenter", function() {
                    panel.style.left = "";
                    const rect = panel.getBoundingClientRect();
                    const viewportWidth = window.innerWidth;
                    if (rect.right > viewportWidth) {
                        const overflowRight = rect.right - viewportWidth;
                        panel.style.left = `calc(50% - ${overflowRight + 20}px)`;
                    } else if (rect.left < 0) {
                        const overflowLeft = -rect.left;
                        panel.style.left = `calc(50% + ${overflowLeft + 20}px)`;
                    }
                });
                item.addEventListener("mouseleave", function() {
                    panel.style.left = "";
                });
            }
        });
    });

    // Sticky header with dynamic padding spacer to prevent layout collapse
    function handleScroll() {
        try {
            const header = document.querySelector(".header-modern");
            const wrapper = document.querySelector(".master-wrapper-page");
            if (header) {
                if (window.scrollY > 50) {
                    if (!header.classList.contains("sticky-shrink")) {
                        const headerHeight = header.offsetHeight;
                        header.classList.add("sticky-shrink");
                        if (wrapper) {
                            wrapper.style.paddingTop = headerHeight + "px";
                        }
                    }
                } else {
                    if (header.classList.contains("sticky-shrink")) {
                        header.classList.remove("sticky-shrink");
                        if (wrapper) {
                            wrapper.style.paddingTop = "0px";
                        }
                    }
                }
            }
        } catch (e) {}
    }
    window.addEventListener("scroll", handleScroll);
    window.addEventListener("resize", function() {
        try {
            const header = document.querySelector(".header-modern");
            const wrapper = document.querySelector(".master-wrapper-page");
            if (header && header.classList.contains("sticky-shrink") && wrapper) {
                header.style.position = "static";
                const naturalHeight = header.offsetHeight;
                header.style.position = "";
                wrapper.style.paddingTop = naturalHeight + "px";
            }
        } catch (e) {}
    });
    document.addEventListener("DOMContentLoaded", handleScroll);
    if (document.readyState === "complete" || document.readyState === "interactive") {
        handleScroll();
    }
</script>
