@model Nop.Plugin.Widgets.ShopifyCheckout.Models.ConfigurationModel
@{
    Layout = "_ConfigurePlugin";
}

<form asp-controller="ShopifyCheckout" asp-action="Configure" method="post">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-header">
                Shopify Integration Settings
            </div>
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="StoreUrl" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="StoreUrl" />
                        <span asp-validation-for="StoreUrl"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="StorefrontAccessToken" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="StorefrontAccessToken" />
                        <span asp-validation-for="StorefrontAccessToken"></span>
                        <small class="form-text text-muted">Enter your Storefront API Access Token (e.g. from Shopify Headless Sales Channel or App API credentials). If left empty, the plugin will attempt to auto-generate one via Shopify Admin API (requires Client ID & Secret below with <code>write_storefront_access_tokens</code> scope).</small>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="AdminApiAccessToken" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="AdminApiAccessToken" />
                        <span asp-validation-for="AdminApiAccessToken"></span>
                        <small class="form-text text-muted">Direct static Admin Access Token (shpat_...). If left empty, the plugin will attempt OAuth Client Credentials exchange using Client ID & Secret below.</small>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="ClientId" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ClientId" />
                        <span asp-validation-for="ClientId"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="ClientSecret" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ClientSecret" />
                        <span asp-validation-for="ClientSecret"></span>
                        <small class="form-text text-muted">Used for automatic <code>grant_type=client_credentials</code> access token retrieval.</small>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="ApiVersion" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ApiVersion" />
                        <span asp-validation-for="ApiVersion"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="DisplayButtonOnShoppingCart" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="DisplayButtonOnShoppingCart" />
                        <span asp-validation-for="DisplayButtonOnShoppingCart"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="DisplayButtonOnPaymentMethod" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="DisplayButtonOnPaymentMethod" />
                        <span asp-validation-for="DisplayButtonOnPaymentMethod"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="FallbackToSkuAsVariantId" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="FallbackToSkuAsVariantId" />
                        <span asp-validation-for="FallbackToSkuAsVariantId"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="EnableAutoCatalogSync" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="EnableAutoCatalogSync" />
                        <span asp-validation-for="EnableAutoCatalogSync"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="CustomButtonText" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="CustomButtonText" />
                        <span asp-validation-for="CustomButtonText"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="submit" name="save" class="btn btn-primary">
                            @T("Admin.Common.Save")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<div class="cards-group mt-3">
    <div class="card card-default">
        <div class="card-header">
            Catalog Initial Population & Full Sync
        </div>
        <div class="card-body">
            <p>Push your entire nopCommerce product catalog and variant combinations to Shopify, automatically mapping all resulting Shopify Variant IDs back into your local database.</p>
            <form asp-controller="ShopifyCheckout" asp-action="RunFullCatalogSync" method="post">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-sync-alt"></i> Run Full Catalog Sync to Shopify
                </button>
            </form>
        </div>
    </div>
</div>
