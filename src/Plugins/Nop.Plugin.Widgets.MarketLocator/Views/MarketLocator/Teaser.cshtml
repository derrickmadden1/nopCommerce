@model Nop.Plugin.Widgets.MarketLocator.Models.MarketTeaserModel
@if (Model.NextMarkets.Any())
{
    var desktopExtraCount = Model.TotalCount - Model.NextMarkets.Count;
    var mobileExtraCount = Model.TotalCount - 1;
    var hasExtraDates = Model.AllMarkets.Any(m => m.Dates.Count > 1);
    var showMoreTrigger = desktopExtraCount > 0 || mobileExtraCount > 0 || hasExtraDates;

    <style>
        .market-teaser,
        .market-teaser * {
            box-sizing: border-box;
        }
        .market-teaser {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.65rem;
            flex-wrap: wrap;
            background: #fdfbf7;
            border: 1px solid #ede5d3;
            border-radius: 10px;
            padding: 0.55rem 1rem;
            margin: 0.4rem 0 0.85rem;
            color: #3d2b1f;
            font-size: 0.88rem;
            box-shadow: 0 2px 8px rgba(61, 43, 31, 0.05);
        }
        .market-teaser__main {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            flex-wrap: wrap;
            flex: 1 1 auto;
            min-width: 0;
        }
        .market-teaser__content {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.4rem;
            min-width: 0;
        }
        .market-teaser__headline {
            font-weight: 600;
            color: #6b5b4d;
            white-space: nowrap;
        }
        a.market-teaser__item {
            display: inline-block;
            background: #f5f0e8;
            border: 1px solid #e6decb;
            border-radius: 6px;
            padding: 0.2rem 0.55rem;
            font-size: 0.83rem;
            line-height: 1.35;
            color: #3d2b1f !important;
            text-decoration: none !important;
            cursor: pointer;
            transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
        }
        a.market-teaser__item:hover {
            background: #eae2d3;
            border-color: #4a6741;
            color: #3d2b1f !important;
            transform: translateY(-1px);
            box-shadow: 0 2px 5px rgba(61, 43, 31, 0.1);
        }
        a.market-teaser__item.today {
            background: #fdf2f0;
            border-color: #eabfb9;
        }
        a.market-teaser__item.today:hover {
            background: #fae5e1;
            border-color: #c0392b;
        }
        a.market-teaser__item.soon {
            background: #eaf3e8;
            border-color: #c2d8bc;
        }
        a.market-teaser__item.soon:hover {
            background: #dcebd9;
            border-color: #4a6741;
        }
        .market-teaser__date-sep {
            white-space: nowrap;
        }
        .market-teaser__more-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.2rem;
            background: rgba(74, 103, 65, 0.12);
            color: #35512c;
            border: 1px solid rgba(74, 103, 65, 0.35);
            border-radius: 999px;
            padding: 0.2rem 0.6rem;
            font-size: 0.78rem;
            font-weight: 600;
            white-space: nowrap;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .market-teaser__more-btn:hover,
        .market-teaser__more-btn[aria-expanded="true"] {
            background: #4a6741;
            border-color: #4a6741;
            color: #ffffff;
        }
        .market-teaser__more-label--mobile {
            display: none;
        }
        .market-teaser__cta {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            margin-left: auto;
            background: #4a6741;
            color: #ffffff !important;
            font-weight: 600;
            font-size: 0.8rem;
            letter-spacing: 0.01em;
            text-decoration: none !important;
            white-space: nowrap;
            padding: 0.38rem 0.85rem;
            border-radius: 999px;
            border: 1px solid #4a6741;
            box-shadow: 0 2px 6px rgba(74, 103, 65, 0.2);
            transition: background 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
        }
        .market-teaser__cta:hover {
            background: #3b5334;
            border-color: #3b5334;
            color: #ffffff !important;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(74, 103, 65, 0.28);
        }
        .market-teaser__cta-arrow {
            display: inline-block;
            transition: transform 0.18s ease;
        }
        .market-teaser__cta:hover .market-teaser__cta-arrow {
            transform: translateX(3px);
        }
        .market-teaser__popup {
            display: none;
            position: absolute;
            left: 0;
            right: 0;
            top: calc(100% + 0.4rem);
            z-index: 1000;
            width: 100%;
            max-width: 520px;
            max-height: 68vh;
            overflow-y: auto;
            overflow-x: hidden;
            background: #fdfbf7;
            color: #3d2b1f;
            border: 1px solid #ede5d3;
            border-radius: 10px;
            box-shadow: 0 10px 28px rgba(61, 43, 31, 0.18);
            padding: 0.85rem 1rem;
            text-align: left;
        }
        .market-teaser__popup.is-open {
            display: block;
        }
        .market-teaser__popup-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 0.5rem;
            margin-bottom: 0.55rem;
            border-bottom: 1px solid #ede5d3;
        }
        .market-teaser__popup-title {
            font-weight: 700;
            font-size: 0.9rem;
            color: #3d2b1f;
        }
        .market-teaser__popup-close {
            background: none;
            border: none;
            font-size: 1.25rem;
            line-height: 1;
            color: #8c7b6b;
            cursor: pointer;
            padding: 0.1rem 0.35rem;
            border-radius: 4px;
        }
        .market-teaser__popup-close:hover {
            background: #ede5d3;
            color: #3d2b1f;
        }
        .market-teaser__popup-list {
            display: flex;
            flex-direction: column;
            gap: 0.55rem;
        }
        .market-teaser__popup-item {
            padding-bottom: 0.55rem;
            border-bottom: 1px solid #f2ece1;
        }
        .market-teaser__popup-item:last-child {
            padding-bottom: 0;
            border-bottom: none;
        }
        .market-teaser__popup-item-top {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 0.25rem 0.5rem;
            flex-wrap: wrap;
            margin-bottom: 0.3rem;
        }
        .market-teaser__popup-name {
            font-weight: 700;
            color: #3d2b1f;
            text-decoration: none;
            font-size: 0.86rem;
        }
        .market-teaser__popup-name:hover {
            color: #4a6741;
            text-decoration: underline;
        }
        .market-teaser__popup-meta {
            font-size: 0.75rem;
            color: #8c7b6b;
        }
        .market-teaser__popup-dates {
            display: flex;
            flex-wrap: wrap;
            gap: 0.3rem;
        }
        a.market-teaser__date-pill {
            display: inline-block;
            background: #f0ede6;
            color: #3d2b1f !important;
            border: 1px solid #e2d9c5;
            border-radius: 6px;
            padding: 0.14rem 0.48rem;
            font-size: 0.76rem;
            font-weight: 500;
            text-decoration: none !important;
            transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
        }
        a.market-teaser__date-pill:hover {
            background: #e4ddd0;
            border-color: #4a6741;
            transform: translateY(-1px);
        }
        a.market-teaser__date-pill--first {
            background: #eaf3e8;
            border-color: #b7d1b0;
            color: #35512c !important;
            font-weight: 600;
        }
        a.market-teaser__date-pill--first:hover {
            background: #dcebd9;
            border-color: #4a6741;
        }
        .market-teaser__popup-footer {
            margin-top: 0.7rem;
            padding-top: 0.55rem;
            border-top: 1px solid #ede5d3;
            display: flex;
            justify-content: flex-end;
        }
        .market-teaser__popup-cta {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            background: #4a6741;
            color: #ffffff !important;
            font-weight: 600;
            font-size: 0.78rem;
            text-decoration: none !important;
            padding: 0.35rem 0.8rem;
            border-radius: 999px;
            transition: background 0.15s ease;
        }
        .market-teaser__popup-cta:hover {
            background: #3b5334;
            color: #ffffff !important;
        }

        /* ── Compact Mobile Layout ───────────────────────────────── */
        @@media (max-width: 767px) {
            .market-teaser {
                padding: 0.45rem 0.65rem;
                margin: 0.25rem 0 0.55rem;
                gap: 0.35rem;
                border-radius: 8px;
            }
            .market-teaser__content {
                gap: 0.3rem;
                width: 100%;
            }
            .market-teaser__headline-text {
                display: none;
            }
            a.market-teaser__item--extra-mobile {
                display: none !important;
            }
            a.market-teaser__item {
                font-size: 0.78rem;
                padding: 0.18rem 0.45rem;
                max-width: calc(100% - 1.8rem);
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }
            .market-teaser__more-label--desktop {
                display: none;
            }
            .market-teaser__more-label--mobile {
                display: inline;
            }
            .market-teaser__more-btn {
                font-size: 0.74rem;
                padding: 0.18rem 0.5rem;
            }
            .market-teaser__cta {
                font-size: 0.74rem;
                padding: 0.25rem 0.65rem;
            }
            .market-teaser__popup {
                max-width: 100%;
                padding: 0.75rem 0.8rem;
                max-height: 62vh;
            }
            .market-teaser__popup-item-top {
                flex-direction: column;
                gap: 0.1rem;
            }
        }
    </style>

    <div class="market-teaser" id="market-teaser-widget">
        <div class="market-teaser__main">
            <div class="market-teaser__content">
                <span class="market-teaser__headline">📍<span class="market-teaser__headline-text"> Find us at a market:</span></span>
                @for (var i = 0; i < Model.NextMarkets.Count; i++)
                {
                    var item = Model.NextMarkets[i];
                    <a href="/market-locations?id=@item.Id"
                       class="market-teaser__item @item.Status @(i > 0 ? "market-teaser__item--extra-mobile" : "")"
                       title="View @item.Name on map">
                        <strong>@item.Name</strong> <span class="market-teaser__date-sep">· @item.NextDate</span>
                    </a>
                }
                @if (showMoreTrigger)
                {
                    <button type="button"
                            class="market-teaser__more market-teaser__more-btn"
                            id="market-teaser-more-btn"
                            aria-expanded="false"
                            aria-controls="market-teaser-popup">
                        <span class="market-teaser__more-label--desktop">@(desktopExtraCount > 0 ? $"+{desktopExtraCount} more" : "+more dates") ▾</span>
                        <span class="market-teaser__more-label--mobile">@(mobileExtraCount > 0 ? $"+{mobileExtraCount} more" : "+more dates") ▾</span>
                    </button>
                }
            </div>
        </div>
        <a href="/market-locations" class="market-teaser__cta">
            <span>See all locations</span>
            <span class="market-teaser__cta-arrow">→</span>
        </a>

        @if (showMoreTrigger)
        {
            <div class="market-teaser__popup" id="market-teaser-popup" role="dialog" aria-label="Upcoming market dates">
                <div class="market-teaser__popup-header">
                    <span class="market-teaser__popup-title">📅 Upcoming Markets &amp; Dates</span>
                    <button type="button" class="market-teaser__popup-close" id="market-teaser-popup-close" aria-label="Close">×</button>
                </div>
                <div class="market-teaser__popup-list">
                    @foreach (var market in Model.AllMarkets)
                    {
                        <div class="market-teaser__popup-item">
                            <div class="market-teaser__popup-item-top">
                                <a href="/market-locations?id=@market.Id" class="market-teaser__popup-name">@market.Name</a>
                                <span class="market-teaser__popup-meta">
                                    @market.City@(!string.IsNullOrWhiteSpace(market.Hours) ? $" · {market.Hours}" : "")
                                </span>
                            </div>
                            <div class="market-teaser__popup-dates">
                                @for (var i = 0; i < market.Dates.Count; i++)
                                {
                                    <a href="/market-locations?id=@market.Id"
                                       class="market-teaser__date-pill @(i == 0 ? "market-teaser__date-pill--first" : "")"
                                       title="View @market.Name on map">@market.Dates[i]</a>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="market-teaser__popup-footer">
                    <a href="/market-locations" class="market-teaser__popup-cta">
                        <span>See map &amp; all locations</span>
                        <span>→</span>
                    </a>
                </div>
            </div>

            <script>
                (function () {
                    const widget = document.getElementById('market-teaser-widget');
                    const btn = document.getElementById('market-teaser-more-btn');
                    const popup = document.getElementById('market-teaser-popup');
                    const closeBtn = document.getElementById('market-teaser-popup-close');
                    if (!widget || !btn || !popup) return;

                    function setOpen(open) {
                        popup.classList.toggle('is-open', open);
                        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
                    }

                    btn.addEventListener('click', function (e) {
                        e.stopPropagation();
                        setOpen(!popup.classList.contains('is-open'));
                    });

                    if (closeBtn) {
                        closeBtn.addEventListener('click', function (e) {
                            e.stopPropagation();
                            setOpen(false);
                        });
                    }

                    document.addEventListener('click', function (e) {
                        if (popup.classList.contains('is-open') && !widget.contains(e.target)) {
                            setOpen(false);
                        }
                    });

                    document.addEventListener('keydown', function (e) {
                        if (e.key === 'Escape' && popup.classList.contains('is-open')) {
                            setOpen(false);
                            btn.focus();
                        }
                    });
                })();
            </script>
        }
    </div>
}
