@model Nop.Plugin.Widgets.AgentSearch.Models.AgentSearchConfigurationModel

@{
    Layout = "_ConfigurePlugin";
}

<form asp-controller="AgentSearch" asp-action="Configure" method="post">
    <nop-antiforgery-token />
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-header">
                Agent Search API Settings
            </div>
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="Enabled" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="Enabled" />
                        <span asp-validation-for="Enabled"></span>
                        <p class="text-muted">Master on/off switch for the Agent Search API endpoint (POST /api/agent/search).</p>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="MaxResultsDefault" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="MaxResultsDefault" />
                        <span asp-validation-for="MaxResultsDefault"></span>
                        <p class="text-muted">Default number of search results returned when caller does not specify max_results.</p>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="MaxResultsCap" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="MaxResultsCap" />
                        <span asp-validation-for="MaxResultsCap"></span>
                        <p class="text-muted">Hard ceiling on max results returned per query regardless of caller request.</p>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="RequireApiKey" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="RequireApiKey" />
                        <span asp-validation-for="RequireApiKey"></span>
                        <p class="text-muted">If enabled, callers must provide a valid API Key in the X-Api-Key HTTP header or Authorization: Bearer token.</p>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="ApiKey" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ApiKey" html-attributes="@(new { type = "password", autocomplete = "off" })" />
                        <span asp-validation-for="ApiKey"></span>
                        <p class="text-muted">Legacy fallback API Key (used if multi-tenant key check falls back).</p>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="UseQueryUnderstanding" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="UseQueryUnderstanding" />
                        <span asp-validation-for="UseQueryUnderstanding"></span>
                        <p class="text-muted">Enable natural-language constraint extraction pass prior to hitting Azure AI Search.</p>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="submit" name="save" class="btn btn-primary">
                            @T("Admin.Common.Save")
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Multi-Tenant Agent API Key Management Card -->
        <div class="card card-default mt-4">
            <div class="card-header">
                Multi-Tenant Third-Party Agent API Keys
            </div>
            <div class="card-body">
                <p class="text-muted">Register and manage individual API keys for AI Agent platforms (OpenAI, Claude, Perplexity, custom bots). Keys authenticate both <strong>Agent Search</strong> and <strong>Universal Commerce Protocol (UCP)</strong> catalog endpoints.</p>
                
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Agent Name</th>
                            <th>Key Prefix</th>
                            <th>Status</th>
                            <th>Rate Limit</th>
                            <th>Allowed Scopes</th>
                            <th>Created (UTC)</th>
                            <th>Last Used (UTC)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ExistingKeys != null && Model.ExistingKeys.Any())
                        {
                            foreach (var keyItem in Model.ExistingKeys)
                            {
                                <tr>
                                    <td><strong>@keyItem.AgentName</strong></td>
                                    <td><code>@keyItem.KeyPrefix...</code></td>
                                    <td>
                                        @if (keyItem.IsActive)
                                        {
                                            <span class="badge badge-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>@keyItem.RateLimitPerMinute req/min</td>
                                    <td><small>@keyItem.AllowedScopes</small></td>
                                    <td>@keyItem.CreatedOnUtc.ToString("g")</td>
                                    <td>@(keyItem.LastUsedOnUtc.HasValue ? keyItem.LastUsedOnUtc.Value.ToString("g") : "Never")</td>
                                    <td>
                                        <form asp-controller="AgentSearch" asp-action="ToggleKeyStatus" asp-route-id="@keyItem.Id" method="post" style="display:inline;">
                                            <nop-antiforgery-token />
                                            <button type="submit" class="btn btn-xs @(keyItem.IsActive ? "btn-warning" : "btn-success")">
                                                @(keyItem.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                        <form asp-controller="AgentSearch" asp-action="DeleteKey" asp-route-id="@keyItem.Id" method="post" style="display:inline;" onclick="return confirm('Are you sure you want to delete this agent key?');">
                                            <nop-antiforgery-token />
                                            <button type="submit" class="btn btn-xs btn-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">No multi-tenant agent API keys registered yet. Generate one below.</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <hr />
                <h5 class="mt-4">Generate New Agent API Key</h5>
                <form asp-controller="AgentSearch" asp-action="CreateKey" method="post">
                    <nop-antiforgery-token />
                    <div class="form-group row">
                        <div class="col-md-3">
                            <label class="col-form-label">Agent Name / Identifer</label>
                        </div>
                        <div class="col-md-9">
                            <input asp-for="NewAgentName" class="form-control" placeholder="e.g. OpenAI-ChatGPT, PerplexityBot" required />
                            <small class="text-muted">Identifies the third-party client or organization.</small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <label class="col-form-label">Rate Limit (req / min)</label>
                        </div>
                        <div class="col-md-9">
                            <input asp-for="NewRateLimitPerMinute" class="form-control" type="number" min="1" max="10000" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <label class="col-form-label">Allowed Scopes</label>
                        </div>
                        <div class="col-md-9">
                            <input asp-for="NewAllowedScopes" class="form-control" placeholder="Search.Read,Catalog.Read" />
                            <small class="text-muted">Comma-separated permissions (e.g. Search.Read, Catalog.Read, Cart.Write).</small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-9 offset-md-3">
                            <button type="submit" class="btn btn-success">
                                Generate Agent API Key
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</form>
