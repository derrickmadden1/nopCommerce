@{
    Layout = "";
}

<div id="paypal-redirect-loader" class="paypal-redirect-loading" style="margin: 30px auto; padding: 40px 20px; max-width: 600px; text-align: center; background: #fafafa; border: 1px solid #ebebeb; border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
    <div class="paypal-spinner" style="width: 36px; height: 36px; border: 3px solid #e2e8f0; border-top: 3px solid #0070ba; border-radius: 50%; animation: paypal-spin 0.8s linear infinite; margin-bottom: 14px;"></div>
    <div style="font-size: 1.05rem; font-weight: 600; color: #1e293b; margin-bottom: 6px;">Connecting to PayPal...</div>
    <div style="font-size: 0.875rem; color: #64748b;">Preparing your secure payment options</div>
</div>

<style>
    @@keyframes paypal-spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

<script asp-location="Footer">
    $(function () {
        $('button.payment-info-next-step-button').hide();
        window.location = '@(Url.RouteUrl(PayPalCommerceDefaults.Route.PaymentInfo))';
    });
</script>