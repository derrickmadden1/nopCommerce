@model ConfigurationModel
@{
    Layout = "_ConfigurePlugin";
}

<form asp-controller="WinbackEmail" asp-action="Configure" method="post">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-header">General Settings</div>
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="Enabled" /></div>
                    <div class="col-md-9"><nop-editor asp-for="Enabled" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="DryRun" /></div>
                    <div class="col-md-9"><nop-editor asp-for="DryRun" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="StoreName" /></div>
                    <div class="col-md-9"><nop-editor asp-for="StoreName" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="FromEmail" /></div>
                    <div class="col-md-9"><nop-editor asp-for="FromEmail" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="FromName" /></div>
                    <div class="col-md-9"><nop-editor asp-for="FromName" /></div>
                </div>
            </div>
        </div>

        <div class="card card-default">
            <div class="card-header">Azure OpenAI Settings</div>
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="AzureOpenAIEndpoint" /></div>
                    <div class="col-md-9"><nop-editor asp-for="AzureOpenAIEndpoint" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="AzureOpenAIApiKey" /></div>
                    <div class="col-md-9"><nop-editor asp-for="AzureOpenAIApiKey" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="DeploymentName" /></div>
                    <div class="col-md-9"><nop-editor asp-for="DeploymentName" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="UseAzureKeyVault" /></div>
                    <div class="col-md-9"><nop-editor asp-for="UseAzureKeyVault" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="AzureKeyVaultUrl" /></div>
                    <div class="col-md-9"><nop-editor asp-for="AzureKeyVaultUrl" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="AzureKeyVaultSecretName" /></div>
                    <div class="col-md-9"><nop-editor asp-for="AzureKeyVaultSecretName" /></div>
                </div>
            </div>
        </div>

        <div class="card card-default">
            <div class="card-header">Email Schedules</div>
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="Email1DaysLapsed" /></div>
                    <div class="col-md-9"><nop-editor asp-for="Email1DaysLapsed" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="DaysBetweenEmail1And2" /></div>
                    <div class="col-md-9"><nop-editor asp-for="DaysBetweenEmail1And2" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="DaysBetweenEmail2And3" /></div>
                    <div class="col-md-9"><nop-editor asp-for="DaysBetweenEmail2And3" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="MaxDaysLapsed" /></div>
                    <div class="col-md-9"><nop-editor asp-for="MaxDaysLapsed" /></div>
                </div>
            </div>
        </div>

        <div class="card card-default">
            <div class="card-header">Email 3 Discount Settings</div>
            <div class="card-body">
                <p class="text-muted" style="margin-bottom: 20px;">
                    When enabled, an exclusive, single-use coupon code is dynamically generated for each customer with <code>NTimesOnly = 1</code> limitation, guaranteeing it can only be redeemed once even if the customer checks out as a guest.
                </p>
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="Email3DiscountAmount" /></div>
                    <div class="col-md-9"><nop-editor asp-for="Email3DiscountAmount" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="Email3DiscountUsePercentage" /></div>
                    <div class="col-md-9"><nop-editor asp-for="Email3DiscountUsePercentage" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="Email3DiscountPrefix" /></div>
                    <div class="col-md-9"><nop-editor asp-for="Email3DiscountPrefix" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="Email3DiscountExpiryDays" /></div>
                    <div class="col-md-9"><nop-editor asp-for="Email3DiscountExpiryDays" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="Email3DiscountCode" /></div>
                    <div class="col-md-9">
                        <nop-editor asp-for="Email3DiscountCode" />
                        <span class="hint">Fallback static promo code. Only used if Discount Value is set to 0.</span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="submit" name="save" class="btn btn-primary">
                            <i class="far fa-save"></i> Save Changes
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<form asp-controller="WinbackEmail" method="post" style="margin-top: 20px;">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-header">Manual Execution & Upcoming Emails</div>
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="submit" asp-action="RunNow" name="run-now" class="btn btn-info">
                            <i class="fas fa-play"></i> Run Winback Task Now
                        </button>
                        <button type="submit" asp-action="ResetAndRun" name="reset-and-run" class="btn btn-warning" style="margin-left: 10px;" onclick="return confirm('Are you sure you want to clear dry-run history and regenerate winback emails?');">
                            <i class="fas fa-sync-alt"></i> Reset History & Regenerate Emails
                        </button>
                        <a asp-action="Upcoming" asp-controller="WinbackEmail" class="btn btn-primary" style="margin-left: 10px;">
                            <i class="fas fa-calendar-alt"></i> View Upcoming Emails
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
