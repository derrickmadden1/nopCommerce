@model ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
}

@await Component.InvokeAsync("StoreScopeConfiguration")

<form asp-controller="RoyalMailShipping" asp-action="Configure" method="post">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-header">
                <i class="fas fa-shipping-fast"></i> Royal Mail Web Tracking Configuration
            </div>
            <div class="card-body">
                <div class="callout callout-info">
                    <h5><i class="icon fas fa-info-circle"></i> Direct Web Tracking Active</h5>
                    <p>
                        Shipment tracking numbers entered for Royal Mail shipments (e.g. <code>YD 0260 6106 9GB</code>) will automatically link directly to Royal Mail's official public tracking portal. Both customers and store administrators can click the tracking number to view full tracking history, signature confirmation, safeplace photos, and GPS delivery maps.
                    </p>
                    <p class="mb-0">
                        <em>Note: Direct Tracking API access requires an enterprise OBA account posting 25k+ tracked items/year. Web tracking links do not require API access or credentials.</em>
                    </p>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="WebTrackingUrlFormat_OverrideForStore" asp-input="WebTrackingUrlFormat" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="WebTrackingUrlFormat" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="WebTrackingUrlFormat" />
                        <span asp-validation-for="WebTrackingUrlFormat"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="submit" name="save" class="btn btn-primary">
                            <i class="far fa-save"></i> Save
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
